docker rm -f xfce-desktop webtop 2>/dev/null; \
docker run -d --name=xfce-desktop --shm-size=512m -p 6901:6901 \
  -v /workspaces/pizza-abo-youssef:/mnt/repo \
  -v desktop_downloads:/home/headless/Downloads \
  accetto/ubuntu-vnc-xfce-g3:latest && \
docker exec -u root xfce-desktop bash -c '
set -e
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y wget ca-certificates zip unzip
install -d -m 0755 /etc/apt/keyrings
wget -O /etc/apt/keyrings/packages.mozilla.org.asc https://packages.mozilla.org/apt/repo-signing-key.gpg
echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main" > /etc/apt/sources.list.d/mozilla.list
printf "Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n" > /etc/apt/preferences.d/mozilla
apt-get update
apt-get install -y firefox
readlink -f /usr/bin/firefox | grep -q "^/usr/lib/firefox" && echo "=== FIREFOX OK ===" || { echo "=== WRONG FIREFOX (snap stub) ==="; exit 1; }
zip -v | head -2 && unzip -v | head -1
' && \
docker exec -u root xfce-desktop bash /mnt/repo/witanime/setup_codespace.sh && \
docker exec -u root -e GITHUB_TOKEN="$GITHUB_TOKEN" xfce-desktop bash /mnt/repo/witanime/start_bot.sh
